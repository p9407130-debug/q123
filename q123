#include <stdio.h>
int main() {
    int n, i;
    printf("Enter the size of the array: ");
    scanf("%d", &n);
    int arr[n];
    int result = 0;
    printf("Enter %d elements: ", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        result ^= arr[i]; 
    }
    printf("Repeated/XOR result: %d\n", result);
    return 0;
}
